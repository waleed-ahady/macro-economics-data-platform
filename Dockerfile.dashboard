FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip && pip install ".[dashboard]"

EXPOSE 8501

CMD ["streamlit", "run", "src/macro_data_platform/dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
